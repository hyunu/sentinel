# Sentinel AI backend configuration.
# Copy to .env (docker compose reads it automatically) or export in your shell.
#
# AI_PROVIDER:
#   openai    = any OpenAI-compatible /chat/completions endpoint
#               (OpenAI, vLLM, Ollama, FriendliAI, EXAONE, Gemini compat, ...)
#   anthropic = Anthropic Messages API
#
# Leave AI_MODEL empty to disable AI. /api/v1/ai/query then returns 503.

AI_PROVIDER=openai
AI_BASE_URL=http://localhost:8000/v1
# Must match the model name served by vLLM/Ollama/FriendliAI.
AI_MODEL=exaone-4.0-32b
AI_API_KEY=local

AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=60
AI_MAX_TOOL_ROUNDS=6

# Anthropic example:
# AI_PROVIDER=anthropic
# AI_BASE_URL=https://api.anthropic.com
# AI_MODEL=claude-sonnet-4-5
# AI_API_KEY=sk-ant-...
