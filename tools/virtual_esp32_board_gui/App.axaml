<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VirtualEsp32Board.Gui.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#0D1117" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
      <Setter Property="Foreground" Value="#E6EDF3" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#131A24" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BorderBrush" Value="#1F2A3A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #55000000" />
    </Style>

    <Style Selector="Border.subcard">
      <Setter Property="Background" Value="#0F1826" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BorderBrush" Value="#1E2B3D" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.divider">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F5F7FA" />
    </Style>

    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#95A3B8" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#7DD3FC" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#AFC0D4" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="#182233" />
      <Setter Property="Foreground" Value="#E6EDF3" />
      <Setter Property="BorderBrush" Value="#2A3B52" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="38" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0EA5E9" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Button.stop">
      <Setter Property="Background" Value="#EF4444" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0F1722" />
      <Setter Property="BorderBrush" Value="#253347" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#0F1722" />
      <Setter Property="BorderBrush" Value="#253347" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="38" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="#0B111A" />
      <Setter Property="BorderBrush" Value="#1E2B3D" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="#22D3EE" />
      <Setter Property="Background" Value="#152233" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Application.Styles>
</Application>
