  "_meta": {
    "name": "LCP Monitoring + Control",
    "description": "LCP↔OSP monitoring(CA) + control RPC(CF/CD/CC/CE) — AA [LEN:1] envelope, 1-byte total length",
    "version": "2.1",
    "frame": "AA [LEN:1] FID [SEQ:2 BE] ATTR payload CRC16 BB",
    "notes": {
      "length": "LEN은 AA부터 BB까지 전체 바이트 수",
      "payload_len": "payload 길이 = LEN - 9",
      "crc16": "CRC-16/XMODEM, AA ~ payload 마지막 바이트",
      "fids": {
        "0xCA": "monitoring status (97 fields)",
        "0xCD": "function result/error",
        "0xCF": "function call",
        "0xCC": "packet ACK",
        "0xCE": "heartbeat",
        "0xC8": "INIT",
        "0xC7": "instant monitor request"
      }
    }
  }
