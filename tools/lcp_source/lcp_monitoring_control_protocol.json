          "204": [
            {
              "name": "recv_fid",
              "type": "U8"
            },
            {
              "name": "error_code",
              "type": "U8"
            }
          ],
          "205": [
            {
              "name": "result_count",
              "type": "U8"
            },
            {
              "name": "results",
              "type": "RepeatCount",
              "count_from": "result_count",
              "item_rules": [
                {
                  "name": "flag",
                  "type": "U8"
                },
                {
                  "name": "len",
                  "type": "U8"
                },
                {
                  "name": "result",
                  "type": "Optional",
                  "predicate": {
                    "expr": "flag == 0xFD"
                  },
                  "rules": [
                    {
                      "name": "function_id",
                      "type": "U8"
                    },
                    {
                      "name": "result_data",
                      "type": "VarBytes",
                      "length_from": {
                        "expr": "len - 3"
                      }
                    }
                  ]
                },
                {
                  "name": "error",
                  "type": "Optional",
                  "predicate": {
                    "expr": "flag == 0xFE"
                  },
                  "rules": [
                    {
                      "name": "function_id",
                      "type": "U8"
                    },
                    {
                      "name": "error_code",
                      "type": "U8"
                    }
                  ]
                },
                {
                  "name": "monitor",
                  "type": "Optional",
                  "predicate": {
                    "expr": "flag == 0xF9"
                  },
                  "rules": [
                    {
                      "name": "dms_result",
                      "type": "U8"
                    },
                    {
                      "name": "monitor_data",
                      "type": "VarBytes",
                      "length_from": {
                        "expr": "len > 3 ? len - 3 : 0"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "206": [
            {
              "name": "monitor_flag",
              "type": "Validate",
              "inner": {
                "type": "U8"
              },
              "validate_expr": "value == 0xF8"
            },
            {
              "name": "monitor_len",
              "type": "U8"
            },
            {
              "name": "monitor_data",
              "type": "VarBytes",
              "length_from": {
                "expr": "monitor_len - 2"
              }
            }
          ],
          "207": [
            {
              "name": "monitor_flag",
              "type": "Validate",
              "inner": {
                "type": "U8"
              },
              "validate_expr": "value == 0xF8"
            },
            {
              "name": "monitor_len",
              "type": "U8"
            },
            {
              "name": "monitor_data",
              "type": "VarBytes",
              "length_from": {
                "expr": "monitor_len - 2"
              }
            },
            {
              "name": "function_count",
              "type": "U8"
            },
            {
              "name": "functions",
              "type": "RepeatCount",
              "count_from": "function_count",
              "item_rules": [
                {
                  "name": "flag",
                  "type": "Validate",
                  "inner": {
                    "type": "U8"
                  },
                  "validate_expr": "value == 0xFC || value == 0xFB"
                },
                {
                  "name": "len",
                  "type": "U8"
                },
                {
                  "name": "function_id",
                  "type": "U8"
                },
                {
                  "name": "arg_count",
                  "type": "U8"
                },
                {
                  "name": "args",
                  "type": "RepeatCount",
                  "count_from": "arg_count",
                  "item_rules": [
                    {
                      "name": "flag",
                      "type": "Validate",
                      "inner": {
                        "type": "U8"
                      },
                      "validate_expr": "value == 0xFA"
                    },
                    {
                      "name": "len",
                      "type": "U8"
                    },
                    {
                      "name": "val",
                      "type": "VarBytes",
                      "length_from": {
                        "expr": "len - 2"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "198": [
            {
              "name": "monitor_flag",
              "type": "Validate",
              "inner": {
                "type": "U8"
              },
              "validate_expr": "value == 0xF8"
            },
            {
              "name": "monitor_len",
              "type": "U8"
            },
            {
              "name": "monitor_data",
              "type": "VarBytes",
              "length_from": {
                "expr": "monitor_len - 2"
              }
            },
            {
              "name": "tail",
              "type": "VarBytes",
              "length_from": {
                "expr": "length > 24 ? length - 24 : 0"
              }
            }
          ]
        },
        "default": [
          {
            "name": "raw_payload",
            "type": "VarBytes",
            "length_from": {
              "expr": "length > 9 ? length - 9 : 0"
            }
          }
        ]
      },
      {
        "name": "crc16",
        "type": "U16",
        "endian": "big"
      },
      {
        "name": "etx",
        "type": "Validate",
        "validate_expr": "value == 0xBB",
        "inner": {
          "type": "U8"
        }
      }
    ]
